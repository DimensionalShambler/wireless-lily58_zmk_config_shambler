/*
 * ZMK keymap for the Boardsource Wireless Lily58 SMT ("blelulu").
 * Converted from the QMK keymap.c (QWERTY / LOWER / RAISE / ADJUST).
 *
 * Replace config/blelulu.keymap in the firmware repo with this file.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* Layer numbers. Order here must match the order of the layer nodes below. */
#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    /* QMK update_tri_layer_state(LOWER, RAISE, ADJUST) */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        /* QMK TT(layer): hold = momentary layer, tap = toggle layer. */
        tt: tap_toggle_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

/* QWERTY
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | ESC  |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  |  DEL |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | Tab  |   Q  |   W  |   E  |   R  |   T  |                    |   Y  |   U  |   I  |   O  |   P  |  "   |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |LShift|   A  |   S  |   D  |   F  |   G  |-------.    ,-------|   H  |   J  |   K  |   L  |   ;  |Enter |
 * |------+------+------+------+------+------|Launchy|    | prnsc |------+------+------+------+------+------|
 * |LCtrl |   Z  |   X  |   C  |   V  |   B  |-------|    |-------|   N  |   M  |   ,  |   .  |   /  | RSFT |
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *                   | LAlt | Win  |Lower | /  BkSpc  /       \Space \  |Lower | -_   | +=   |
 *                   `----------------------------'           '------''--------------------'
 */
        base_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                              &kp N6 &kp N7    &kp N8    &kp N9  &kp N0    &kp DEL
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                               &kp Y  &kp U     &kp I     &kp O   &kp P     &kp SQT
&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G                               &kp H  &kp J     &kp K     &kp L   &kp SEMI  &kp RET
&kp LCTRL &kp Z  &kp X  &kp C    &kp V    &kp B     &kp LA(SPACE)  &kp PSCRN  &kp N  &kp M     &kp COMMA &kp DOT &kp FSLH  &kp RSHFT
                        &kp LALT &kp LGUI &mo LOWER &kp BSPC       &kp SPACE  &mo LOWER &kp MINUS &kp EQUAL
            >;
        };

/* LOWER
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | ESC  |  F1  |  F2  |  F3  |  F4  |  F5  |                    |  F6  |  F7  |  F8  |  F9  | F10  | Ins  |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |      | F11  | F12  | DEL  |      |      |                    | PgUp | Home |  Up  | End  |Ctl+Rt|  \   |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |LShift|      |      |      |      | BkSp |-------.    ,-------| PgDn | Left | Down |Right |      |  '   |
 * |------+------+------+------+------+------| Enter |    |       |------+------+------+------+------+------|
 * |LCtrl | F11  | F12  |  F5  |      |      |-------|    |-------| End  | PgDn |  [   |  ]   |  \   |      |
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *                   |      |TT Rse|      | /       /       \      \  |      | Menu |      |
 *                   `----------------------------'           '------''--------------------'
 */
        lower_layer {
            display-name = "Lower";
            bindings = <
&kp ESC   &kp F1       &kp F2  &kp F3  &kp F4 &kp F5                        &kp F6    &kp F7    &kp F8   &kp F9    &kp F10       &kp INS
&trans    &kp F11      &kp F12 &kp DEL &trans &trans                        &kp PG_UP &kp HOME  &kp UP   &kp END   &kp RC(RIGHT) &kp BSLH
&kp LSHFT &trans       &trans  &trans  &trans &kp BSPC                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &trans        &kp SQT
&kp LCTRL &kp F11      &kp F12 &kp F5  &trans &trans    &kp RET   &trans    &kp END   &kp PG_DN &kp LBKT &kp RBKT  &kp BSLH      &trans
                               &trans  &tt RAISE RAISE  &trans    &trans    &trans    &trans    &kp K_APP &trans
            >;
        };

/* RAISE
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * |      |      |      |      |      |      |                    |      |      |      |      |      |      |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |   `  |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  |      |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |-------.    ,-------|      | Left | Down |  Up  |Right |      |
 * |------+------+------+------+------+------|       |    |       |------+------+------+------+------+------|
 * |  F7  |  F8  |  F9  | F10  | F11  | F12  |-------|    |-------|   +  |   -  |   =  |   [  |   ]  |   \  |
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *                   |      |      |      | /       /       \      \  |      |      |      |
 *                   `----------------------------'           '------''--------------------'
 * The QMK RGB_* keys on this layer have no equivalent on this board (no RGB), so they are &none.
 */
        raise_layer {
            display-name = "Raise";
            bindings = <
&none     &none  &none  &none   &none   &none                        &trans   &trans    &trans    &trans   &trans    &trans
&kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                       &kp N6   &kp N7    &kp N8    &kp N9   &kp N0    &trans
&kp F1    &kp F2 &kp F3 &kp F4  &kp F5  &kp F6                       &none    &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &none
&kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12   &none    &trans    &kp PLUS &kp MINUS &kp EQUAL &kp LBKT &kp RBKT  &kp BSLH
                        &trans  &trans  &trans    &trans   &trans    &trans   &trans    &trans
            >;
        };

/* ADJUST (LOWER + RAISE held together)
 * The QMK layer only had RGB keys. This board is wireless and has no RGB, so the
 * top row carries the Bluetooth controls you need instead:
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * |BT CLR| BT 0 | BT 1 | BT 2 | BT 3 | BT 4 |                    | USB  | BLE  |OutTog|      |      | Boot |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * (all other keys do nothing)
 * BT CLR forgets the pairing of the currently selected profile. BT 0-4 pick a profile.
 * USB / BLE / OutTog choose where keystrokes go. Boot puts the left half in flashing mode.
 */
        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &out OUT_USB &out OUT_BLE &out OUT_TOG &none &none &bootloader
&none      &none        &none        &none        &none        &none                         &none        &none        &none        &none &none &none
&none      &none        &none        &none        &none        &none                         &none        &none        &none        &none &none &none
&none      &none        &none        &none        &none        &none        &none   &none    &none        &none        &none        &none &none &none
                                                  &trans       &trans       &trans  &trans   &trans       &trans       &trans       &trans
            >;
        };
    };
};
